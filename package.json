{
  "name": "cloudflare-rag-portfolio",
  "version": "0.1.0",
  "description": "Cloudflare-first agentic RAG portfolio demo — Agents SDK, Workers AI, Vectorize, D1, R2 (epic #30; pivoting from an earlier single-turn RAG demo)",
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "npm run corpus:build && cd ui && npm run build",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler deploy",
    "deploy:production": "npm run build && npm run db:migrate:remote && wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "db:migrate": "wrangler d1 migrations apply wikipedia-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply wikipedia-db --remote",
    "db:create-migration": "wrangler d1 migrations create wikipedia-db",
    "vectorize:create": "wrangler vectorize create wikipedia-vectors --preset @cf/baai/bge-base-en-v1.5",
    "r2:create": "wrangler r2 bucket create wikipedia-articles",
    "ui:dev": "cd ui && npm run dev",
    "ui:build": "cd ui && npm run build",
    "ui:preview": "cd ui && npm run preview",
    "fetch-data": "python scripts/fetch-wikipedia.py --size-mb 10",
    "fetch-data:quick": "python scripts/fetch-wikipedia.py --size-mb 5",
    "fetch-data:large": "python scripts/fetch-wikipedia.py --size-mb 20",
    "corpus:build": "node scripts/build-corpus.js",
    "ingest": "node scripts/ingest-wikipedia.js",
    "ingest:corpus": "node scripts/ingest-wikipedia.js ./data/corpus",
    "prepare": "husky || true",
    "lint": "eslint . --max-warnings 0 && npm run lint --prefix ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "ai",
    "rag",
    "retrieval-augmented-generation",
    "vectorize",
    "d1",
    "r2",
    "portfolio"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.0",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.19.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.18.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.49.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.121.0"
  },
  "dependencies": {
    "@cloudflare/ai-chat": "^0.10.1",
    "@langchain/textsplitters": "^1.0.1",
    "agents": "^0.20.1",
    "ai": "^7.0.62",
    "hono": "^4.6.14",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.4.3"
  }
}
